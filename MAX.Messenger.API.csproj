<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MAX.Messenger.API</RootNamespace>
    <Nullable>enable</Nullable>
	  
    <PackageId>MAX.Messenger.API</PackageId>
    <Version>0.2.0</Version>
	<PackageVersion>0.2.0</PackageVersion>
    <Authors>Gennady Goncharov</Authors>
    <Company>BizChatBots</Company>
    <Description>Unofficial .NET client for MAX Messenger API</Description>

	<PackageTags>max;messenger;bot;api</PackageTags>
	<PackageProjectUrl>https://github.com/genixg/MAX.Messenger.API</PackageProjectUrl>
	<PackageIcon>max-icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/genixg/MAX.Messenger.API</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	  
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<ImplicitUsings>enable</ImplicitUsings>
	  
	<PackageReleaseNotes>
	  BREAKING: Base URL changed to https://platform-api2.max.ru (required since Jul 2026)
	  BREAKING: added error codes (field "code"); responses with success=false now throw MaxApiException instead of being silently ignored
	  BREAKING: SendMessageAsync returns MaxMessage (mid/seq of created message no longer lost)
	  BREAKING: UploadAsync rewritten to the official two-step flow (POST /uploads?type= + upload to returned URL); old direct multipart /upload no longer supported by MAX
	  BREAKING: removed dead types UploadResponse, FileUploadResult usage, MaxCreateSubscriptionRequest; MaxSubscription now has url/time/update_types per spec
	  New: full method coverage of MAX Bot API: GET /me, PATCH /me/commands, chats info/edit/actions/pin/members/admins/leave, GET+PUT+DELETE /messages, GET /messages/(id), GET /videos/(token), comments (send/get/edit/delete/get by id), GET /updates (long polling), subscriptions with secret
	  New: all update types (message_edited/removed, comment_created/edited/removed, bot_added/removed, user_added/removed, bot_stopped, dialog_*, chat_title_changed, bot_admin_permissions_changed)
	  Fix: MaxUpdate.Timestamp was a field, so it was never deserialized - now a property; added all update payload fields (title, is_channel, permissions, post_id, muted_until, etc.)
	  New: typed attachment payloads (image/video/audio/file/sticker/contact/share/location) + GetPayload&lt;T&gt;()
	  New: html text format, clipboard keyboard button type, CancellationToken support on all methods
	</PackageReleaseNotes>
	  
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
	<None Include="max-icon.png" Pack="true" PackagePath="" />
	<None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
