<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>MAX.Messenger.API</RootNamespace>
    <Nullable>enable</Nullable>
	  
    <PackageId>MAX.Messenger.API</PackageId>
    <Version>0.1.0</Version>
    <Authors>Gennady Goncharov</Authors>
    <Company>BizChatBots</Company>
    <Description>Unofficial .NET client for MAX Messenger API</Description>
	
	<RepositoryUrl>https://github.com/genixg/MAX.Messenger.API</RepositoryUrl>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
